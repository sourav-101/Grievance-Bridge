# Copy to .env.local and fill in. Never commit real keys.

# ---------------------------------------------------------------- App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Bare domain (no protocol/port) of the deployed site. Only used in OTP mode, for the
# WebOTP line "@your-domain #1234" at the end of the SMS so Chrome can auto-fill the code.
NEXT_PUBLIC_APP_DOMAIN=localhost
# 32+ random characters you generate yourself (not from any website). Signs worker
# sessions and grievance drafts, and peppers PIN hashes. Changing it logs everyone out
# and invalidates all PINs, so set it once and keep it secret.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
WORKER_SESSION_SECRET=YOUR_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
# How workers log in:
#   pin = mobile number + 4-digit PIN (default; no SMS provider needed)
#   otp = mobile number + SMS OTP via Fast2SMS (needs the FAST2SMS_* values below)
AUTH_MODE=pin
# Only used when AUTH_MODE=otp. true = the OTP is shown on screen instead of being sent
# by SMS (testing only). MUST be false in production.
OTP_DEV_MODE=true

# ---------------------------------------------------------------- Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Name of the private storage bucket created by 0001_init.sql — leave as is.
SUPABASE_AUDIO_BUCKET=worker-audio-vault

# ---------------------------------------------------------------- Fast2SMS (only needed when AUTH_MODE=otp)
FAST2SMS_API_KEY=YOUR_FAST2SMS_API_KEY
# q   = Quick SMS: custom text, includes the WebOTP auto-fill line (higher per-SMS price)
# otp = Fast2SMS fixed OTP template (WebOTP auto-fill will NOT work; workers type the code)
# dlt = Your own DLT-approved template (end the template with "@your-domain #{#var#}" for auto-fill)
FAST2SMS_ROUTE=q
FAST2SMS_DLT_SENDER_ID=YOUR_DLT_SENDER_ID
FAST2SMS_DLT_TEMPLATE_ID=YOUR_DLT_TEMPLATE_ID

# ---------------------------------------------------------------- Sarvam AI (speech)
SARVAM_API_KEY=YOUR_SARVAM_API_KEY
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
# Any bulbul:v3 speaker id (lowercase). Listen to samples in the Sarvam dashboard and pick one.
SARVAM_TTS_SPEAKER=priya
SARVAM_TTS_PACE=0.9

# ---------------------------------------------------------------- Groq (reasoning)
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=openai/gpt-oss-120b
# Second model with its own quota, used automatically when the main one is rate-limited
# or fails. "none" switches this off.
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b

# ---------------------------------------------------------------- Google Gemini (embeddings for RAG)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ---------------------------------------------------------------- Tavily (live web search fallback)
TAVILY_API_KEY=YOUR_TAVILY_API_KEY

# ---------------------------------------------------------------- Tuning
# Below this cosine similarity the knowledge-base answer is considered unreliable
# and the agent falls back to live web search.
RAG_CONFIDENCE_THRESHOLD=0.70
